# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=golang:1.26.7@sha256:e30143be198ab04cf7ba25fba83ab3a692ca584c994aad0bf131fa0eb32dd8c1
FROM ${GO_IMAGE} AS dev
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips-dev=8.16.1-1+deb13u1 \
    libmagickwand-7.q16-dev=8:7.1.1.43+dfsg1-1+deb13u11 \
    libheif-plugin-aomenc=1.19.8-1+deb13u1 pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod download gopkg.in/gographics/imagick.v3@v3.7.3

FROM dev AS build
ARG GIT_COMMIT=development
COPY cmd/ cmd/
COPY internal/ internal/
COPY experiments/e2-transformer-ab/diagnostics/codec_trace.c experiments/e2-transformer-ab/diagnostics/codec_trace.c
RUN go build -buildvcs=false -o /out/e2-vips ./cmd/e2-vips \
 && go build -buildvcs=false -o /out/e2-magick ./cmd/e2-magick \
 && go build -buildvcs=false -ldflags="-X main.commit=${GIT_COMMIT}" -o /out/e2-run ./cmd/e2-run \
 && gcc -shared -fPIC -o /out/e2-codec-trace.so experiments/e2-transformer-ab/diagnostics/codec_trace.c -lheif -ldl

FROM debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
 ca-certificates libvips42t64=8.16.1-1+deb13u1 \
 libmagickwand-7.q16-10=8:7.1.1.43+dfsg1-1+deb13u11 \
 libheif-plugin-aomenc=1.19.8-1+deb13u1 \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir /results && chown 10001:10001 /results
COPY --from=build /out/ /app/
COPY experiments/e2-transformer-ab/fixtures/generated/ /app/corpus/
ENV GOMAXPROCS=1 OMP_NUM_THREADS=1 MAGICK_THREAD_LIMIT=1 VIPS_CONCURRENCY=1
USER 10001:10001
WORKDIR /app
ENTRYPOINT ["/app/e2-run"]
